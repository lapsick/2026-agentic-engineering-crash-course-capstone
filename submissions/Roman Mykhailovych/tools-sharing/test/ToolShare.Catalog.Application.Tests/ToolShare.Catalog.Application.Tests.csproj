         "membership" schema into the shared per-test database. -->
    <ProjectReference Include="..\..\src\ToolShare.Membership.Application\ToolShare.Membership.Application.csproj" />
    <ProjectReference Include="..\..\src\ToolShare.Membership.EntityFrameworkCore\ToolShare.Membership.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.TestBase\ToolShare.TestBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Volo.Abp.TestBase" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.EventBus" Version="10.6.0" />
  </ItemGroup>

</Project>
