<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ToolShare.Catalog</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolShare.Catalog.Application\ToolShare.Catalog.Application.csproj" />
    <ProjectReference Include="..\..\src\ToolShare.Catalog.EntityFrameworkCore\ToolShare.Catalog.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\ToolShare.Application\ToolShare.Application.csproj" />
    <ProjectReference Include="..\..\src\ToolShare.EntityFrameworkCore\ToolShare.EntityFrameworkCore.csproj" />
