<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ToolShare.Lending</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolShare.Lending.Domain\ToolShare.Lending.Domain.csproj" />
    <ProjectReference Include="..\ToolShare.Lending.Application.Contracts\ToolShare.Lending.Application.Contracts.csproj" />
    <!-- Lending calls into both modules' published contracts (research R2, membership-consumption.md) -->
    <ProjectReference Include="..\ToolShare.Catalog.Application.Contracts\ToolShare.Catalog.Application.Contracts.csproj" />
    <ProjectReference Include="..\ToolShare.Membership.Application.Contracts\ToolShare.Membership.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="10.6.0" />
