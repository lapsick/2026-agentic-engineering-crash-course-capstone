<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>ToolShare-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
    <RootNamespace>ToolShare.Blazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Components.Server.MudBlazorBasicTheme" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.7.0-rc.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolShare.Application\ToolShare.Application.csproj" />
    <ProjectReference Include="..\ToolShare.HttpApi\ToolShare.HttpApi.csproj" />
    <ProjectReference Include="..\ToolShare.EntityFrameworkCore\ToolShare.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.Catalog.Application\ToolShare.Catalog.Application.csproj" />
    <ProjectReference Include="..\ToolShare.Catalog.EntityFrameworkCore\ToolShare.Catalog.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.Catalog.Blazor\ToolShare.Catalog.Blazor.csproj" />
    <ProjectReference Include="..\ToolShare.Membership.Application\ToolShare.Membership.Application.csproj" />
    <ProjectReference Include="..\ToolShare.Membership.EntityFrameworkCore\ToolShare.Membership.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.Membership.Blazor\ToolShare.Membership.Blazor.csproj" />
    <ProjectReference Include="..\ToolShare.Lending.Application\ToolShare.Lending.Application.csproj" />
    <ProjectReference Include="..\ToolShare.Lending.EntityFrameworkCore\ToolShare.Lending.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.Lending.Blazor\ToolShare.Lending.Blazor.csproj" />
    <ProjectReference Include="..\ToolShare.Notifications.Application\ToolShare.Notifications.Application.csproj" />
    <ProjectReference Include="..\ToolShare.Notifications.EntityFrameworkCore\ToolShare.Notifications.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ToolShare.Notifications.Blazor\ToolShare.Notifications.Blazor.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Identity.Blazor.MudBlazor.Server" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Blazor.MudBlazor.Server" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Blazor.MudBlazor.Server" Version="10.6.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
