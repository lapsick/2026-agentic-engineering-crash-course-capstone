<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ToolShare.Membership.Blazor</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor/AuthorizationHandlerContext in
         Security/MembershipActiveMemberRequirement.cs (T062) — a class library
         (Microsoft.NET.Sdk.Razor) does not get the ASP.NET Core shared
         framework implicitly the way the host's Web SDK project does. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolShare.Membership.Application.Contracts\ToolShare.Membership.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Components.Web" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Components.Web.Theming.MudBlazor" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.UI.Navigation" Version="10.6.0" />
  </ItemGroup>

</Project>
