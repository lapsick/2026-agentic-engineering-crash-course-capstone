**/wwwroot/libs/** linguist-vendored

# Normalize line endings on commit; check out native on each platform.
* text=auto

# Files consumed by Linux containers MUST stay LF — CRLF breaks the
# shebang and produces "no such file or directory" at container start.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
docker-compose*.yml text eol=lf
.dockerignore   text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary assets — never diff or convert.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
*.pfx           binary
*.snk           binary
